{
  "manifest_version": 3,
  "name": "Kix - Kick Color Changer",
  "version": "1.0.0",
  "description": "Change the accent color of Kick.com live streaming across all pages with custom hex codes, HSL sliders, and quick presets.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kix",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://*.kick.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.kick.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}